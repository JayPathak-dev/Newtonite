# Newtonite Ops environment configuration
# Copy this file to .env and fill in actual values

# Database
POSTGRES_USER=newtonite
POSTGRES_PASSWORD=newtonite_dev_password
POSTGRES_DB=newtonite_ops
DATABASE_URL=postgresql+psycopg://newtonite:newtonite_dev_password@localhost:5435/newtonite_ops
TEST_DATABASE_URL=postgresql+psycopg://newtonite:newtonite_dev_password@localhost:5436/newtonite_ops_test

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# App
APP_ENV=development
LOG_LEVEL=INFO

# Frontend
VITE_API_BASE_URL=http://localhost:8000
